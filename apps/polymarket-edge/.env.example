# Copy to .env for local runs. Never commit real values.

# Required for persistence. Supabase > Project Settings > API Keys > "Secret keys" (sb_secret_...).
# Server-side only: it bypasses RLS. Without it the scanner keeps data in memory.
SUPABASE_URL=https://ylhojqettwscqrobjtze.supabase.co
SUPABASE_SECRET_KEY=

# Required for signals. https://the-odds-api.com (free tier: 500 credits/month).
# Without it the scanner runs Polymarket-only and logs a warning.
ODDS_API_KEY=

# Optional: protects the dashboard with HTTP basic auth (any username).
DASHBOARD_PASSWORD=

# Optional tuning (defaults shown).
# LEAGUES=nba,nfl,epl,laliga,bundesliga,seriea,ligue1,ucl
# SCAN_INTERVAL_MIN=10
# ODDS_REFRESH_HOURS=6
# ODDS_LOOKAHEAD_HOURS=24
# ODDS_MONTHLY_BUDGET=450
# PAPER_TRADING_ENABLED=true
# BANKROLL_START=1000
# KELLY_FRACTION=0.25
# MAX_STAKE_PCT=0.02
# MAX_STAKE_USD=25
# MIN_EDGE=0.02
# MAX_EDGE=0.15
